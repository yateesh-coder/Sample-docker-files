node run build - package.json, dist/

FROM node:20-slim
RUN useradd -r appuser
WORKDIR /app
COPY --chown=appuser:appuser package*.json ./
RUN npm ci --omit=dev
COPY --chown=appuser:appuser dist ./dist
USER appuser
EXPOSE 9000
CMD ["node","dist/server.js"]

